{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nailit.dev/schema/question_bank.schema.json",
  "title": "NailIt Question Bank",
  "description": "Standardized question-bank format for NailIt.",
  "type": "object",
  "required": ["name", "questions"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/question" }
    }
  },
  "definitions": {
    "question": {
      "type": "object",
      "required": ["id", "domain", "topic", "level", "type", "question"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "topic": { "type": "string", "minLength": 1 },
        "level": { "type": "integer", "minimum": 1 },
        "type": {
          "type": "string",
          "enum": ["open", "single_choice", "multiple_choice", "true_false"]
        },
        "question": { "type": "string", "minLength": 1 },
        "answer": { "type": ["string", "null"] },
        "choices": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "correct": {
          "type": ["array", "null"],
          "items": { "type": "integer", "minimum": 0 }
        },
        "explanation": { "type": ["string", "null"] },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "level_chain": { "type": ["string", "null"] },
        "prerequisites": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["single_choice", "multiple_choice", "true_false"]
              }
            }
          },
          "then": {
            "required": ["choices", "correct"],
            "properties": {
              "choices": { "type": "array", "minItems": 1 },
              "correct": { "type": "array", "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "open" } }
          },
          "then": {
            "required": ["answer"],
            "properties": {
              "answer": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    }
  }
}
